# Copy to .env. Never commit real credentials.
VEY_CONFIG=config/vey.toml
VEY_DATABASE_URL=postgresql+psycopg://vey_core:CHANGE_ME@localhost:5432/vey
VEY_CORE_DATABASE_URL=postgresql+psycopg://vey_core:CHANGE_ME@postgres-container-name:5432/vey
VEY_EXEC_DATABASE_URL=postgresql+psycopg://vey_executor:CHANGE_ME@postgres-container-name:5432/vey
# An EXISTING user-defined Docker network shared with the existing PostgreSQL container.
VEY_DATABASE_NETWORK=existing-postgres-network
VEY_DOCKER_GID=999
VEY_RUNTIME_DIR=/opt/vey/run
VEY_EXECUTOR_TOKEN_FILE=/run/secrets/executor_token
VEY_MODEL_KEY_FILE=/run/secrets/deepseek_key
VEY_MODEL_BASE_URL=https://api.deepseek.com
VEY_MODEL_NAME=deepseek-flash
VEY_WECOM_CORP_ID=
VEY_WECOM_AGENT_ID=0
VEY_WECOM_SECRET_FILE=/run/secrets/wecom_secret
VEY_WECOM_TOKEN_FILE=/run/secrets/wecom_token
VEY_WECOM_AES_KEY_FILE=/run/secrets/wecom_aes_key
# Default closed. Local authenticated debug only; never proxy /debug publicly.
VEY_DEBUG_ENABLED=false
VEY_DEBUG_TOKEN_FILE=/run/secrets/debug_token
